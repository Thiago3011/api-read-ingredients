# Configuração para executar a API diretamente no host (Windows/Linux/macOS)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/allergy_validator

# Troque o valor de exemplo por uma chave aleatória antes de usar fora da máquina local.
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=30

# Caminho do Tesseract no host; deixe vazio para usar o PATH.
TESSERACT_CMD=

# Credenciais locais do Docker Compose. Não reutilize estes valores em produção.
# Se o volume postgres_data já existe, mantenha as credenciais com que ele foi criado.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=allergy_validator
APP_PORT=8000
POSTGRES_PORT=5432
